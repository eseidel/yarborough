# Pyodide and Z3 are version-pinned and checksum-verified, and Vite
# content-hashes everything under /assets, so these can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must revalidate or a deploy goes unnoticed.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/site.webmanifest
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=3600
