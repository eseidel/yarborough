{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Production. Deployed only by the "Promote to production" workflow, which
  // redeploys an artifact that was already published to preview.
  "name": "saycbridge",
  "compatibility_date": "2026-08-28",

  // Assets-only Worker: there is no `main`, so requests are served straight
  // from ./dist without invoking Worker code.
  "assets": {
    "directory": "./dist",
    // Deep links such as /bid/<board> are client-routed by React Router, so
    // unmatched paths must serve index.html rather than 404.
    "not_found_handling": "single-page-application",
  },

  // Cloudflare creates the DNS records and certificates for these. The apex was
  // previously a dead A record; www previously served the legacy App Engine site
  // via ghs.google.com. Both are replaced by this Worker.
  "routes": [
    { "pattern": "saycbridge.com", "custom_domain": true },
    { "pattern": "www.saycbridge.com", "custom_domain": true },
  ],

  // saycbridge.com is the canonical origin, so no *.workers.dev twin for prod.
  "workers_dev": false,
  "observability": { "enabled": true },

  "env": {
    // Preview, deployed on every push to main. Wrangler names this Worker
    // "saycbridge-preview".
    "preview": {
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
      "routes": [{ "pattern": "dev.saycbridge.com", "custom_domain": true }],
      // Kept as a fallback URL; preview has no canonical-origin concerns.
      "workers_dev": true,
      "observability": { "enabled": true },
    },
  },
}
